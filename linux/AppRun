#!/bin/bash
#
# Launcher for the Debrify AppImage.
#
# Lives here rather than in a heredoc inside .github/workflows/build.yml so the
# x64 and arm64 jobs cannot drift apart, and so the driver-path logic below is
# reviewable on its own.

SELF=$(readlink -f "$0")
HERE=${SELF%/*}
APPLIB="${HERE}/usr/bin/lib"
PRIVATE_MPV="${APPLIB}/mpv/libmpv.so.2"

export PATH="${HERE}/usr/bin:${PATH}"

# Dart opens libmpv separately from the native media_kit video plugin. Point
# that dlopen at the same private file the plugin resolves through its RUNPATH.
# No LD_LIBRARY_PATH is exported: GTK, Mesa, VA-API, Vulkan and audio dispatch
# libraries must remain the host's copies for the lifetime of the process.
if [ ! -f "$PRIVATE_MPV" ]; then
  echo "Debrify AppImage is missing its private libmpv: $PRIVATE_MPV" >&2
  exit 127
fi
export LIBMPV_LIBRARY_PATH="$PRIVATE_MPV"

exec "${HERE}/usr/bin/debrify" "$@"
