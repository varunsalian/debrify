<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.
         
         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
    <!-- Dark, red-accented dialog for the TV subtitle title-search flow.
         Fixes the default AppCompat teal accent + light button so the dialog
         matches the Netflix-style player chrome. -->
    <style name="Theme.Debrify.SubtitleDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/debrify_red</item>
        <item name="colorControlNormal">#66FFFFFF</item>
        <item name="colorControlActivated">@color/debrify_red</item>
        <item name="colorControlHighlight">#33E50914</item>
        <item name="android:textColorPrimary">@color/netflix_text_primary</item>
        <item name="android:textColorSecondary">@color/netflix_text_secondary</item>
        <item name="android:textColorHint">#80FFFFFF</item>
        <item name="android:editTextColor">@color/netflix_text_primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.Debrify.SubtitleDialog.Button</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.Debrify.SubtitleDialog.Button</item>
    </style>

    <style name="Theme.Debrify.SubtitleDialog.Button" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/debrify_red</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DebrifyTvChipButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/debrify_tv_premium_button_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/netflix_text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:elevation">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:translationZ">2dp</item>
    </style>

    <style name="TvBadge">
        <item name="android:background">@drawable/tv_badge_bg</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="TvChip">
        <item name="android:background">@drawable/tv_chip_bg</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?android:selectableItemBackground</item>
        <item name="android:elevation">6dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CINEMA MODE - Premium Control Button Styles
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Standard control button (Audio, Subs, Aspect, etc.) -->
    <style name="CinemaControlButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/cinema_button_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/cinema_control_button_text</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/cinema_control_button_icon</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@animator/cinema_button_state</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Hero Play/Pause button (larger, signature color) -->
    <style name="CinemaPlayButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/cinema_play_button_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/cinema_play_button_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/cinema_play_button_icon</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:elevation">8dp</item>
        <item name="android:stateListAnimator">@animator/cinema_play_button_state</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         OTT DOCK - the Apple TV transport dock (tv_controls.dart) in Views.
         Buttons stay AppCompatButtons because the activity binds these ids as
         Buttons and keeps writing their `text` ("1.2x", "Fill", Play/Pause);
         the text is rendered transparent — the shared caption label under the
         row surfaces the focused button's text instead. The icon is a compound
         drawable centred by fixed box + start padding, so runtime text writes
         never shift it.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Secondary circle: 36dp visual circle in a 42dp box. The compound
         drawables keep their 24dp intrinsic size (shared ic_* set), so the
         start padding centres 24dp in the box: (42-24)/2 = 9dp. -->
    <style name="OttControlButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/ott_button_secondary_bg</item>
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:textSize">2sp</item>
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:drawablePadding">0dp</item>
        <item name="android:drawableTint">@color/ott_button_icon_tint</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Primary play/pause: 44dp visual circle in a 50dp box, 24dp icon. -->
    <style name="OttPlayButton" parent="OttControlButton">
        <item name="android:background">@drawable/ott_button_primary_bg</item>
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:paddingStart">13dp</item>
    </style>

    <!-- ═══ Dock-family skins share OttControlButton's transparent-text
         mechanics; each skin only swaps background/tint/box geometry.
         FROST reuses the Ott* styles verbatim (same white-focus grammar). ═══ -->

    <!-- MARQUEE: bare glyph, no circle, underline focus, airy spacing. -->
    <style name="MarqueeControlButton" parent="OttControlButton">
        <item name="android:background">@drawable/marquee_button_bg</item>
        <item name="android:drawableTint">@color/marquee_button_icon_tint</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <style name="MarqueePlayButton" parent="MarqueeControlButton">
        <item name="android:background">@drawable/marquee_play_bg</item>
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:paddingStart">13dp</item>
    </style>

    <!-- BROADCAST: labeled pill — the ONE dock style whose text is visible,
         so the activity's label writes ("1.2x", "Fill") render on-button and
         no shared caption is needed. -->
    <style name="BroadcastPillButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/broadcast_pill_bg</item>
        <item name="android:textColor">@color/broadcast_button_content</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/broadcast_button_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- BROADCAST transport: icon-only pill (text transparent like Ott). -->
    <style name="BroadcastIconButton" parent="BroadcastPillButton">
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:textSize">2sp</item>
        <item name="android:layout_width">44dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="BroadcastPlayButton" parent="BroadcastIconButton">
        <item name="android:background">@drawable/broadcast_play_bg</item>
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:paddingStart">14dp</item>
    </style>

    <!-- PULSE: accent-ring focus, icons stay light. -->
    <style name="PulseControlButton" parent="OttControlButton">
        <item name="android:background">@drawable/pulse_button_bg</item>
        <item name="android:drawableTint">@color/pulse_button_icon_tint</item>
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:paddingStart">10dp</item>
    </style>

    <style name="PulsePlayButton" parent="PulseControlButton">
        <item name="android:background">@drawable/pulse_play_bg</item>
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:paddingStart">14dp</item>
    </style>

    <!-- TICKET: squared cream buttons with a gold underline focus. -->
    <style name="TicketControlButton" parent="OttControlButton">
        <item name="android:background">@drawable/ticket_button_bg</item>
        <item name="android:drawableTint">@color/ticket_button_icon_tint</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="TicketPlayButton" parent="TicketControlButton">
        <item name="android:background">@drawable/ticket_play_bg</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:paddingStart">12dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         STREAMING MODE - Modern Apple TV+ / Netflix Style Controls
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Icon-only control button (Audio, Subs, Aspect, etc.) -->
    <style name="StreamingIconButton">
        <item name="android:background">@drawable/streaming_control_button_bg</item>
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/streaming_icon_tint</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
    </style>

    <!-- Play/Pause button - Slightly larger with subtle idle highlight -->
    <style name="StreamingPlayButton">
        <item name="android:background">@drawable/streaming_play_button_bg</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/streaming_icon_tint</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TV BROADCAST MODE - Sports Channel Style Controls
         ESPN/Fox Sports inspired - Bold graphics, chunky buttons with labels
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Standard TV control button (icon + label, horizontal compact) -->
    <style name="TvControlButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/tv_control_button_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- TV Play/Pause button - Larger, more prominent -->
    <style name="TvControlButtonPlay">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/tv_control_button_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
    </style>

</resources>
