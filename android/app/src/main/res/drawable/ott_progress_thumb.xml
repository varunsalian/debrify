<?xml version="1.0" encoding="utf-8"?>
<!-- OTT scrub thumb: 12dp solid white circle with a soft accent ring in
     place of the Flutter BoxShadow (accent @ 60%, blur 12). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#99818CF8" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
