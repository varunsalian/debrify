<?xml version="1.0" encoding="utf-8"?>
<!-- Skip intro/credits: a compact glass pill, deliberately quieter than the
     cinema dock buttons. Default is dark glass with a hairline; focus keeps
     the house white-fill (the shared text selector inverts to black) but at
     this size it reads as a small bright chip, not a slab. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <!-- Whisper of a glow so focus reads from the couch -->
            <item android:bottom="-2dp" android:left="-2dp" android:right="-2dp" android:top="-2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#00000000" />
                    <stroke
                        android:width="3dp"
                        android:color="#26FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="@color/cinema_button_focused" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#E6FFFFFF" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#CC0F0F14" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#3DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
