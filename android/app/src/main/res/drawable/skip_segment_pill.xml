<?xml version="1.0" encoding="utf-8"?>
<!-- Skip intro/credits, Netflix-style: a small squared chip, not a pill.
     Default is near-black glass with a crisp light border; focus inverts to
     a flat white fill (the shared text selector turns the label black). No
     glow ring and no scale animator — the inversion IS the focus cue, which
     is what keeps it reading as a compact control instead of a slab. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/cinema_button_focused" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#E6E6E6" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#D9101014" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#59FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
