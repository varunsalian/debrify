<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#14818CF8" />
            <stroke android:width="2dp" android:color="#FF818CF8" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#0B818CF8" />
            <stroke android:width="1dp" android:color="#66818CF8" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#0BFFFFFF" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
