<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF4F1E9" />
            <corners android:radius="6dp" />
            <stroke
                android:width="2dp"
                android:color="#FFF5C451" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF20282C" />
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="#3348D7A0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF141A1D" />
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
