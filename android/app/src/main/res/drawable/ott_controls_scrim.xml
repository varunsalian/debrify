<?xml version="1.0" encoding="utf-8"?>
<!-- Inflate-time stand-in for the OTT scrim. The Flutter dock's gradient has
     FOUR stops (0% clear, 28% -> 40% black, 62% -> 85%, 100% -> 95%) and XML
     gradients cap at three, so the activity replaces this with a programmatic
     ShaderFactory when the OTT skin installs; this keeps the first frame
     close instead of transparent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F2000000"
        android:centerColor="#B3000000"
        android:endColor="#00000000" />
</shape>
