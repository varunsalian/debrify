<?xml version="1.0" encoding="utf-8"?>
<!-- Rundown row: mono columns matching the sheet's header widths (EP 56 /
     TITLE flex / RUNTIME 76 / RTG 52 / STATUS 104). Focus is the yellow bar;
     children duplicateParentState so their text flips to black with it.
     Duration/rating sit inside fixed-width holders because the shared bind
     GONEs them — the holder keeps the column from collapsing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/android_tv_playlist_item_container"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:background="@drawable/gd_row_bcast"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <TextView
        android:id="@+id/gd_item_num"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textColor="@color/gd_row_text_bcast_dim"
        android:textSize="11sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/android_tv_playlist_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/gd_row_text_bcast"
        android:textSize="11.5sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.03" />

    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true">
        <TextView
            android:id="@+id/android_tv_playlist_item_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:textColor="@color/gd_row_text_bcast_dim"
            android:textSize="10.5sp"
            android:fontFamily="monospace"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true">
        <LinearLayout
            android:id="@+id/android_tv_playlist_item_rating_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:duplicateParentState="true"
            android:visibility="gone">
            <TextView
                android:id="@+id/android_tv_playlist_item_rating_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:textColor="@color/gd_row_text_bcast_dim"
                android:textSize="10.5sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/gd_item_status"
        android:layout_width="104dp"
        android:duplicateParentState="true"
        android:layout_height="wrap_content"
        android:textSize="9.5sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:textColor="#8CFFFFFF" />

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="1dp">
        <ImageView android:id="@+id/android_tv_playlist_item_poster"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_fallback"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <View android:id="@+id/android_tv_playlist_item_watched_overlay"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_watched_icon"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <ProgressBar android:id="@+id/android_tv_playlist_item_poster_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_badge"
            android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/android_tv_playlist_item_description"
            android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/android_tv_playlist_item_playing"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_watched"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <FrameLayout android:id="@+id/android_tv_playlist_item_progress_container"
            android:layout_width="1dp" android:layout_height="1dp">
            <TextView android:id="@+id/android_tv_playlist_item_progress_text"
                android:layout_width="1dp" android:layout_height="1dp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
