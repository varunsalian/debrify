<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="86dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/iptv_epg_program_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/iptv_epg_program_time"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:textColor="#FF8D999E"
        android:textSize="11sp"
        tools:text="9:30 PM" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/iptv_epg_program_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFEEF1F1"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Global News Tonight" />

        <TextView
            android:id="@+id/iptv_epg_program_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FF7F8B90"
            android:textSize="10sp"
            tools:text="Headlines, analysis and reports from around the world." />

        <ProgressBar
            android:id="@+id/iptv_epg_program_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:max="1000"
            android:progressBackgroundTint="#1FFFFFFF"
            android:progressTint="#FF48D7A0"
            android:visibility="gone"
            tools:progress="580"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/iptv_epg_program_now"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="#FF1E513F"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="NOW"
        android:textColor="#FFA7F3D0"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
