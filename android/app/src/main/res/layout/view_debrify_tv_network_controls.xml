<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/debrify_controls_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/dtv_network_scrim"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="46dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/dtv_network_plate_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:minWidth="62dp">

                <TextView
                    android:id="@+id/dtv_channel_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/dtv_channel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="7sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.16"
                    android:textAllCaps="true"
                    android:maxWidth="86dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dtv_identity_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEBRIFY TV"
                    android:textColor="#6BFFFFFF"
                    android:textSize="8sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.22" />

                <TextView
                    android:id="@+id/dtv_identity_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:shadowColor="#99000000"
                    android:shadowDy="2"
                    android:shadowRadius="8" />

                <TextView
                    android:id="@+id/dtv_identity_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#B8FFFFFF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

    <LinearLayout
        android:id="@+id/dtv_badges_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/dtv_badge_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/dtv_network_chip_bg"
            android:textColor="#D1FFFFFF"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:visibility="gone" />
        <TextView
            android:id="@+id/dtv_badge_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/dtv_network_chip_bg"
            android:textColor="#D1FFFFFF"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:visibility="gone" />
        <TextView
            android:id="@+id/dtv_badge_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/dtv_network_chip_bg"
            android:textColor="#D1FFFFFF"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:visibility="gone" />
        <TextView
            android:id="@+id/dtv_badge_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/dtv_network_chip_bg"
            android:textColor="#D1FFFFFF"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:visibility="gone" />
    </LinearLayout>
        </LinearLayout>

    <LinearLayout
        android:id="@+id/dtv_progress_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/debrify_time_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dtv_progress_track_bg">

            <View
                android:id="@+id/debrify_progress_line"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/dtv_progress_fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/debrify_time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/debrify_controls_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
    <LinearLayout
        android:id="@+id/debrify_pause_button"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Play / Pause"
        android:background="@drawable/dtv_network_button_bg"
        >
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_dock_pause"
            android:id="@+id/debrify_pause_icon"
            android:tint="@color/dtv_network_icon_tint" />
        <TextView
            android:id="@+id/debrify_pause_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_next_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Next Title"
        android:background="@drawable/dtv_network_button_bg"
        >
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_dock_next"
            
            android:tint="@color/dtv_network_icon_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_channel_next_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Channel Up"
        android:background="@drawable/dtv_network_button_bg"
        >
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_dock_jump"
            
            android:tint="@color/dtv_network_icon_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_guide_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Guide"
        android:background="@drawable/dtv_network_button_bg"
        >
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_dock_eps"
            
            android:tint="@color/dtv_network_icon_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_audio_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Audio"
        android:background="@drawable/dtv_network_button_bg"
        >
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_dock_audio"
            
            android:tint="@color/dtv_network_icon_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_subtitle_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Subtitles"
        android:background="@drawable/dtv_network_button_bg"
        >
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_dock_subs"
            
            android:tint="@color/dtv_network_icon_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_speed_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Speed"
        android:background="@drawable/dtv_network_button_bg"
        >
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_dock_speed"
            
            android:tint="@color/dtv_network_icon_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_aspect_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Aspect Ratio"
        android:background="@drawable/dtv_network_button_bg"
        >
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_dock_aspect"
            
            android:tint="@color/dtv_network_icon_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_night_mode_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Night Mode"
        android:background="@drawable/dtv_network_button_bg"
        >
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_dock_night"
            
            android:tint="@color/dtv_network_icon_tint" />
    </LinearLayout>
    </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/dtv_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="#99FFFFFF"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/debrify_time_display"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
