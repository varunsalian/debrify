<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════════
     UNIFIED PLAYER MENU · Miller-columns · cinema theme (matches control dock)
     Populated programmatically by UnifiedMenuController.
     ═══════════════════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/unified_menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="320dp"
    android:visibility="gone">

    <!-- Scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <!-- Live subtitle appearance preview (shown only on the Appearance tab) -->
    <TextView
        android:id="@+id/unified_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:padding="6dp"
        android:elevation="321dp"
        android:text="Sample subtitle preview"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="132dp"
        android:layout_marginBottom="74dp"
        android:orientation="vertical"
        android:background="#F00D0B10"
        android:elevation="12dp">

        <!-- Netflix-red top accent (matches control bar) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#E50914" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Column 1 · Section -->
            <LinearLayout
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#22000000"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingBottom="10dp"
                    android:text="SECTION"
                    android:textColor="#55FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.16"
                    android:fontFamily="sans-serif-medium" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/unified_col1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#12FFFFFF" />

            <!-- Column 2 · Sub-control -->
            <LinearLayout
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/unified_col2_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingBottom="10dp"
                    android:text="SUBTITLES"
                    android:textColor="#55FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.16"
                    android:fontFamily="sans-serif-medium" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/unified_col2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#12FFFFFF" />

            <!-- Column 3 · Options / actions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/unified_col3_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingBottom="10dp"
                    android:text="OPTIONS"
                    android:textColor="#55FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.16"
                    android:fontFamily="sans-serif-medium" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/unified_col3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
