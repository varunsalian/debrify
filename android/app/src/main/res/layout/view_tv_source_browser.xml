<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_source_browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="330dp"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5101012"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:background="#12000000"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="46dp"
            android:paddingEnd="30dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOURCES"
                android:textColor="#70FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.16"
                android:fontFamily="sans-serif-medium" />

            <ScrollView
                android:id="@+id/tv_source_browser_rail_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="18dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tv_source_browser_rail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1FFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingTop="46dp"
            android:paddingEnd="56dp"
            android:paddingBottom="34dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_source_browser_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#70FFFFFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.16"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_source_browser_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#70FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_source_browser_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#8CFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_source_browser_load_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingTop="11dp"
                android:paddingEnd="14dp"
                android:paddingBottom="11dp"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/tv_source_browser_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tv_source_browser_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
