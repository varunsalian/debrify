<?xml version="1.0" encoding="utf-8"?>
<!-- Frost panel row: small still, title + meta, state at the right edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/android_tv_playlist_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/gd_row_frost"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="58dp"
        android:background="#FF101720">

        <ImageView
            android:id="@+id/android_tv_playlist_item_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/fallback_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/fallback_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF101720" />
            <TextView
                android:id="@+id/android_tv_playlist_item_fallback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#33FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/android_tv_playlist_item_poster_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:progressDrawable="@drawable/tv_progress_drawable"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/android_tv_playlist_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#E0FFFFFF"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/android_tv_playlist_item_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#66FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/android_tv_playlist_item_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#66FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/android_tv_playlist_item_rating_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★"
                    android:textColor="#FFF5C518"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/android_tv_playlist_item_rating_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/now_playing_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Playing"
        android:textColor="#FF10B981"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <TextView
        android:id="@+id/android_tv_playlist_item_watched"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="✓"
        android:textColor="#66FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="1dp">
        <View android:id="@+id/android_tv_playlist_item_watched_overlay"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_watched_icon"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_description"
            android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/android_tv_playlist_item_playing"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <FrameLayout android:id="@+id/android_tv_playlist_item_progress_container"
            android:layout_width="1dp" android:layout_height="1dp">
            <TextView android:id="@+id/android_tv_playlist_item_progress_text"
                android:layout_width="1dp" android:layout_height="1dp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
