<?xml version="1.0" encoding="utf-8"?>
<!-- OTT shelf card. Reuses the legacy id contract (EpisodeViewHolder /
     MovieViewHolder bind these); unused legacy ids live as tiny stubs at the
     end so visibility writes never NPE and never render. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/android_tv_playlist_item_container"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:duplicateParentState="true"
        android:foreground="@drawable/gd_focus_ring_ott"
        android:background="#FF15151C">

        <ImageView
            android:id="@+id/android_tv_playlist_item_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/fallback_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/fallback_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF15151C" />
            <TextView
                android:id="@+id/android_tv_playlist_item_fallback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#33FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/android_tv_playlist_item_watched"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:text="✓"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:background="#99000000"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/now_playing_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:text="NOW"
            android:textColor="#FF000000"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="#FFFFFFFF"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/android_tv_playlist_item_poster_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:progressDrawable="@drawable/tv_progress_drawable"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/android_tv_playlist_item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/android_tv_playlist_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#E0FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/android_tv_playlist_item_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/android_tv_playlist_item_rating_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★"
                android:textColor="#FFF5C518"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/android_tv_playlist_item_rating_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Legacy stubs: written to by the shared bind, never rendered. -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="1dp">
        <View android:id="@+id/android_tv_playlist_item_watched_overlay"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_watched_icon"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_description"
            android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/android_tv_playlist_item_playing"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <FrameLayout android:id="@+id/android_tv_playlist_item_progress_container"
            android:layout_width="1dp" android:layout_height="1dp">
            <TextView android:id="@+id/android_tv_playlist_item_progress_text"
                android:layout_width="1dp" android:layout_height="1dp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
