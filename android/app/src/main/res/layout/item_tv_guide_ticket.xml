<?xml version="1.0" encoding="utf-8"?>
<!-- Ticket stub cell: one slim column on the band — badge line with the NOW
     stamp, then the title in mono. The popover above the strip carries the
     art and synopsis for the focused stub. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/android_tv_playlist_item_container"
    android:layout_width="168dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@drawable/gd_cell_ticket"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/android_tv_playlist_item_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#66FFFFFF"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/now_playing_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOW"
            android:textColor="#FF000000"
            android:textSize="8sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:background="#FFEAC981"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/android_tv_playlist_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#CCFFFFFF"
        android:textSize="10.5sp"
        android:fontFamily="monospace" />

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="1dp">
        <ImageView android:id="@+id/android_tv_playlist_item_poster"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_fallback"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <View android:id="@+id/android_tv_playlist_item_watched_overlay"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_watched_icon"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <ProgressBar android:id="@+id/android_tv_playlist_item_poster_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <FrameLayout android:id="@+id/android_tv_playlist_item_rating_badge"
            android:layout_width="1dp" android:layout_height="1dp">
            <TextView android:id="@+id/android_tv_playlist_item_rating_text"
                android:layout_width="1dp" android:layout_height="1dp" />
        </FrameLayout>
        <TextView android:id="@+id/android_tv_playlist_item_description"
            android:layout_width="1dp" android:layout_height="1dp" />
        <TextView android:id="@+id/android_tv_playlist_item_duration"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_playing"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/android_tv_playlist_item_watched"
            android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <FrameLayout android:id="@+id/android_tv_playlist_item_progress_container"
            android:layout_width="1dp" android:layout_height="1dp">
            <TextView android:id="@+id/android_tv_playlist_item_progress_text"
                android:layout_width="1dp" android:layout_height="1dp" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
