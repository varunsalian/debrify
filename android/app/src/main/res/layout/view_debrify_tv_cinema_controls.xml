<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/debrify_controls_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:background="@drawable/dtv_cinema_scrim"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="52dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="114dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/dtv_cinema_poster_bg"
            android:padding="1dp">

            <ImageView
                android:id="@+id/dtv_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/dtv_channel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/dtv_cinema_channel_pill_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="#E7CE9B"
                    android:textSize="8.5sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.14"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="DEBRIFY TV"
                    android:textColor="#59FFFFFF"
                    android:textSize="8sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/dtv_identity_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FBF4E6"
                    android:textSize="28sp"
                    android:fontFamily="serif"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:shadowColor="#B3000000"
                    android:shadowDy="2"
                    android:shadowRadius="10" />

                <TextView
                    android:id="@+id/dtv_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_marginBottom="2dp"
                    android:textColor="#8CFBF4E6"
                    android:textSize="14sp"
                    android:fontFamily="serif"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/dtv_identity_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_marginBottom="2dp"
                    android:textColor="#8CFBF4E6"
                    android:textSize="13sp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/dtv_spec_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#D9B36A"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:textAllCaps="true"
                android:maxLines="1"
                android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/dtv_progress_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/debrify_time_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dtv_progress_track_bg">

            <View
                android:id="@+id/debrify_progress_line"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/dtv_progress_fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/debrify_time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/debrify_controls_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
    <LinearLayout
        android:id="@+id/debrify_pause_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Play / Pause"
        android:background="@drawable/dtv_cinema_pill_bg"
        >
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_wire_pause"
            android:id="@+id/debrify_pause_icon"
            android:tint="@color/dtv_cinema_content_tint" />
        <TextView
            android:id="@+id/debrify_pause_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_next_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Next Title"
        android:background="@drawable/dtv_cinema_pill_bg"
        >
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_wire_next"
            
            android:tint="@color/dtv_cinema_content_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_channel_next_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Channel Up"
        android:background="@drawable/dtv_cinema_pill_bg"
        >
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_wire_jump"
            
            android:tint="@color/dtv_cinema_content_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_guide_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Guide"
        android:background="@drawable/dtv_cinema_pill_bg"
        >
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_wire_eps"
            
            android:tint="@color/dtv_cinema_content_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_audio_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Audio"
        android:background="@drawable/dtv_cinema_pill_bg"
        >
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_wire_audio"
            
            android:tint="@color/dtv_cinema_content_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_subtitle_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Subtitles"
        android:background="@drawable/dtv_cinema_pill_bg"
        >
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_wire_subs"
            
            android:tint="@color/dtv_cinema_content_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_speed_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Speed"
        android:background="@drawable/dtv_cinema_pill_bg"
        >
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_wire_speed"
            
            android:tint="@color/dtv_cinema_content_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_aspect_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Aspect Ratio"
        android:background="@drawable/dtv_cinema_pill_bg"
        >
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_wire_aspect"
            
            android:tint="@color/dtv_cinema_content_tint" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/debrify_night_mode_button"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Night Mode"
        android:background="@drawable/dtv_cinema_pill_bg"
        >
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:src="@drawable/ic_wire_night"
            
            android:tint="@color/dtv_cinema_content_tint" />
    </LinearLayout>
    </LinearLayout>

                <TextView
                    android:id="@+id/dtv_caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="end"
                    android:textColor="#73FFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/debrify_time_display"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
